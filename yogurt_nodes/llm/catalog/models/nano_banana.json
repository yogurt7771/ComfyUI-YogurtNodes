{
  "models": [
    {
      "label": "Nano Banana 2.1",
      "routes": {
        "gemini": {"protocol": "gemini", "model": "gemini-nano-banana-2.1"},
        "openrouter": {"protocol": "openrouter_images", "model": "google/gemini-nano-banana-2.1"}
      },
      "params": [
        {"id": "aspect_ratio", "kind": "combo", "options": ["auto", "1:1", "2:3", "3:2", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9", "1:4", "4:1", "1:8", "8:1"], "tooltip": "'auto' follows the reference image, or the model default when there is none."},
        {"id": "resolution", "kind": "combo", "options": ["1K", "2K", "4K"], "tooltip": "Output resolution."},
        {"id": "thinking_level", "kind": "combo", "default": "MEDIUM", "options": ["MINIMAL", "MEDIUM", "HIGH"], "tooltip": "How much the model reasons before answering; higher is slower and costs more tokens."},
        {"id": "response_modalities", "kind": "combo", "options": ["IMAGE", "IMAGE+TEXT"], "advanced": true, "tooltip": "IMAGE+TEXT also returns the model's text reply."}
      ]
    },
